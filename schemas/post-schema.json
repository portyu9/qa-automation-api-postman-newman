{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JSONPlaceholder Post",
  "type": "object",
  "required": ["userId", "id", "title", "body"],
  "additionalProperties": true,
  "properties": {
    "userId": { "type": "integer", "minimum": 1 },
    "id": { "type": "integer", "minimum": 1 },
    "title": { "type": "string" },
    "body": { "type": "string" }
  }
}
