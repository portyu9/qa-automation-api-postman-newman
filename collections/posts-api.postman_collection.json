{
  "info": {
    "name": "Posts API Quality Contract",
    "description": "Provider-neutral API collection with collection-level response policy, JSON Schema assertions, generated test data, and correlated runs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.environment.get('run_id')) {",
          "  pm.environment.set('run_id', pm.variables.replaceIn('{{$guid}}'));",
          "}",
          "pm.variables.set('request_id', pm.variables.replaceIn('{{$guid}}'));",
          "pm.variables.set('generated_title', `newman-${pm.environment.get('run_id')}-${Date.now()}`);"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('Response time is within the collection budget', function () {",
          "  const maxMs = Number(pm.environment.get('max_response_time_ms') || 3000);",
          "  pm.expect(pm.response.responseTime).to.be.below(maxMs);",
          "});",
          "pm.test('Response is JSON', function () {",
          "  pm.expect(pm.response.headers.get('Content-Type')).to.match(/application\\/json/i);",
          "});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Posts - read",
      "item": [
        {
          "name": "List posts",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "X-Test-Run-Id", "value": "{{run_id}}" },
              { "key": "X-Request-Id", "value": "{{request_id}}" }
            ],
            "url": "{{base_url}}/posts",
            "description": "Returns the post collection and validates every element against the version-controlled post schema."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Body is a non-empty post array matching schema', function () {",
                  "  const body = pm.response.json();",
                  "  const postSchema = JSON.parse(pm.globals.get('post_schema'));",
                  "  pm.expect(body).to.be.an('array').that.is.not.empty;",
                  "  pm.response.to.have.jsonSchema({ type: 'array', items: postSchema });",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get post by id",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "X-Test-Run-Id", "value": "{{run_id}}" },
              { "key": "X-Request-Id", "value": "{{request_id}}" }
            ],
            "url": "{{base_url}}/posts/{{post_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Post matches schema and requested id', function () {",
                  "  const body = pm.response.json();",
                  "  const expectedPostId = pm.iterationData.has('post_id') ? pm.iterationData.get('post_id') : pm.environment.get('post_id');",
                  "  pm.response.to.have.jsonSchema(JSON.parse(pm.globals.get('post_schema')));",
                  "  pm.expect(body.id).to.equal(Number(expectedPostId));",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Posts - write",
      "item": [
        {
          "name": "Create post",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Test-Run-Id", "value": "{{run_id}}" },
              { "key": "X-Request-Id", "value": "{{request_id}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"{{generated_title}}\",\n  \"body\": \"generated by Newman contract test\",\n  \"userId\": {{user_id}}\n}"
            },
            "url": "{{base_url}}/posts"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', function () { pm.response.to.have.status(201); });",
                  "pm.test('Created representation matches request and schema', function () {",
                  "  const body = pm.response.json();",
                  "  const expectedUserId = pm.iterationData.has('user_id') ? pm.iterationData.get('user_id') : pm.environment.get('user_id');",
                  "  pm.response.to.have.jsonSchema(JSON.parse(pm.globals.get('post_schema')));",
                  "  pm.expect(body.title).to.equal(pm.variables.get('generated_title'));",
                  "  pm.expect(body.userId).to.equal(Number(expectedUserId));",
                  "  pm.expect(body.id).to.be.a('number');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
